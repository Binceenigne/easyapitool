# Copy to .env beside the gateway configuration. Keep the real file private.
MIRRA_LISTEN=127.0.0.1:8767
MIRRA_ADMIN_LISTEN=127.0.0.1:8771
MIRRA_ADMIN_PIN=362514
API_TOOLS_SERVICE_TOKEN=
MIRRA_STORAGE_SECRET=
MIRRA_DATA_DIR=./data
API_TOOLS_WORK_DIR=/run/imggen-api
MIRRA_ASSET_DIR=./data/tmp
API_TOOLS_ANDROID_RELEASE_DIR=/opt/imggen-api/releases/android
API_TOOLS_WINDOWS_RELEASE_DIR=/opt/imggen-api/releases/windows

# Legacy phone keys retain their regular upstream. Additional hosts must be named explicitly.
OPENAI_BASE_URL=https://work.easyclin.cn/v1
OPENAI_API_KEY=
MIRRA_ALLOWED_HOSTS=
MIRRA_EGRESS_PROXY=
MIRRA_UPSTREAM_TIMEOUT=12m
MIRRA_PUBLIC_OPENAI_BASE_URL=https://imggen.djyx.pw/openai/v1
MIRRA_OPENAI_POOL=openai
MIRRA_TRUST_LOCAL_PROXY=false

# App defaults. The raw OpenAI-compatible endpoints forward request fields as supplied.
MIRRA_IMAGE_MODEL=gpt-image-2.6-flare
MIRRA_SVG_ENABLED=false
MIRRA_SVG_AUTHOR_MODEL=
MIRRA_SVG_REASONING_EFFORT=
MIRRA_REASONING_MODEL=
MIRRA_REASONING_EFFORT=
MIRRA_REASONING_LUNA_MODEL=
MIRRA_REASONING_TERRA_MODEL=
MIRRA_REASONING_SOL_MODEL=
MIRRA_PROMPT_POLISH_MODEL=

# Standard token prices for gateway accounting; use an absolute path when deploying as a service.
MIRRA_PRICING_FILE=./openai-standard.json
MIRRA_USD_RESERVE_PER_REQUEST=0.01
