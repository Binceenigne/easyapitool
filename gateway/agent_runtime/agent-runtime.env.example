# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Place the same random token in the Go service and private worker environment.
MIRRA_AGENT_WORKER_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS
MIRRA_AGENT_WORKER_HOST=127.0.0.1
MIRRA_AGENT_WORKER_PORT=8774
MIRRA_AGENT_WORKER_URL=http://127.0.0.1:8774
MIRRA_AGENT_PROXY_BASE_URL=http://127.0.0.1:8767/internal/agent/v1
MIRRA_AGENT_MAX_ATTEMPTS=3
MIRRA_IMAGE_MAX_ATTEMPTS=3
