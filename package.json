{
  "name": "djyx-api-tool-ui",
  "version": "1.1.3",
  "private": true,
  "scripts": {
    "build:agents": "node scripts/build-agents.mjs",
    "build:css": "sass --style=expanded --no-source-map frontend/styles/app.scss frontend/styles/app.css && sass --style=expanded --no-source-map frontend/styles/legacy.scss frontend/styles/legacy.css",
    "watch:css": "sass --watch --style=expanded --no-source-map frontend/styles/app.scss:frontend/styles/app.css frontend/styles/legacy.scss:frontend/styles/legacy.css"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "sass": "1.101.0"
  },
  "dependencies": {
    "@openai/agents": "0.22.0",
    "openai": "7.45.1"
  }
}
