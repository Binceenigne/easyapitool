[Unit]
Description=Mirra private OpenAI egress through Seoul Squid
After=network-online.target squid.service mirra-seoul-egress-route.service
Wants=network-online.target mirra-seoul-egress-route.service

[Service]
Type=simple
User=mirra-egress-tunnel
Group=mirra-egress-tunnel
ExecStart=/usr/bin/ssh -NT -i /etc/mirra-egress-tunnel/id_ed25519 -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/mirra-egress-tunnel/known_hosts -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o ConnectTimeout=10 -o IPQoS=none -R 127.0.0.1:18792:172.29.0.4:3128 mirra-seoul-tunnel@39.105.74.222
Restart=always
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
